    },
    {
      "id": "db_metrics",
      "provider": "db_hotdata",
      "config": {
        "type": "db_hotdata",
        "apikey": "${HOTDATA_API_KEY}",
        "workspace_id": "${HOTDATA_WORKSPACE}",
        "ttl": "1h",
        "table": "metrics",
        "allow_execute": true,
        "allow_destructive_load": false,
        "max_attempts": 2,
        "max_execute_rows": 40,
        "job_timeout_secs": 120,
        "async_after_ms": 5000,
        "db_description": "Read-only incident evidence. Never modify or load data during investigation."
      },
      "position": {
