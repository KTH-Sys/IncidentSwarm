# Required for live investigations: https://www.hotdata.dev/
HOTDATA_API_KEY=
HOTDATA_WORKSPACE=

# Persistent telemetry database; create once with:
# uv run python -m bench.preflight --create-telemetry-db
TELEMETRY_DB_ID=

# Model provider credentials and tiers
OPENAI_API_KEY=
FAST_MODEL=gpt-5-mini
STRONG_MODEL=gpt-5

# Required for meaningful cost estimates. Set current USD per 1M tokens for
# both configured models: {"model-name": [input_rate, output_rate]}.
# Preflight rejects unpriced models. Infrastructure and warm-up costs are excluded.
MODEL_PRICING={}

# Optional: enables the fifth (history) specialist and its vector index.
# Search SQL templates remain integration-dependent; see docs/verify.md.
HOTDATA_EMBEDDING_PROVIDER_ID=

# Prefix for temporary investigation databases. Each has a 30-minute TTL.
DB_PREFIX=isw

# Reserved for the planned RocketRide integration; the Python runner does not use it.
ROCKETRIDE_API_KEY=
