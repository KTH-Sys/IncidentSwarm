# Hotdata — per-agent instant DBs + the persistent telemetry DB
HOTDATA_API_KEY=
HOTDATA_WORKSPACE=

# Set once, at 10:00-11:00, after the telemetry DB is created (plan.md §11).
# The telemetry DB is event-scoped: created once, never torn down.
TELEMETRY_DB_ID=

# RocketRide — pipeline orchestration
ROCKETRIDE_API_KEY=

# Model provider
OPENAI_API_KEY=

# Model tiers (§7.2): fast = the five wave-1 agents, strong = the correlator.
# `python -m bench.preflight --list-models` shows what your key can actually use.
FAST_MODEL=gpt-5-mini
STRONG_MODEL=gpt-5

# USD per 1M tokens as {"model": [input, output]} — REQUIRED for cost telemetry.
# Without an entry a model is priced 0, which silently invalidates target T3 and
# every dollar figure in the demo. Copy the current rates from OpenAI's pricing
# page. Preflight fails if a configured model is missing here.
MODEL_PRICING={"gpt-5-mini": [0.25, 2.00], "gpt-5": [1.25, 10.00]}

# Prefix for run-scoped DBs; sweep() reaps orphans matching this (plan.md §8)
DB_PREFIX=isw
